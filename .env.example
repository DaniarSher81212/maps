# =============================================================================
# .env.example — шаблон файла переменных окружения
#
# Что делать:
#   1. Скопируйте этот файл: cp .env.example .env
#   2. Заполните реальными значениями в .env
#   3. .env никогда не коммитим в git (он в .gitignore)!
#
# Зачем хранить настройки здесь, а не в коде?
#   - Безопасность: пароли не попадают в репозиторий
#   - Гибкость: разные окружения (dev/prod) имеют разные значения
#   - Стандарт: 12-factor app methodology
# =============================================================================

# --- Подключение к PostgreSQL ---
# Формат: postgresql://пользователь:пароль@хост:порт/имя_базы
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maps_db
DB_USER=maps_user
DB_PASSWORD=your_password_here

# --- Настройки приложения ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
SESSION_PREFIX=session       # Префикс для имён сессий распределения

# --- Пути к данным ---
DATA_DIR=data                # Папка с Excel-файлами для импорта
EXPORT_DIR=data/exports      # Папка для сохранения результатов

# --- AI-анализ дефицита ---
# Ключ Anthropic API (для функции объяснения причин дефицита)
# Получить: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
