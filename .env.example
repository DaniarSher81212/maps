# =============================================================================
# .env.example — настройки MAPS по умолчанию
#
# Этот файл уже содержит рабочие значения для быстрого старта.
# Для production-окружения замените пароли на свои.
#
# Использование:
#   cp .env.example .env      — скопировать (делается автоматически при start.sh)
#   nano .env                 — отредактировать при необходимости
# =============================================================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maps_db
DB_USER=maps_user
DB_PASSWORD=***REMOVED-PASSWORD***

# --- Приложение ---
APP_ENV=production
LOG_LEVEL=INFO
SESSION_PREFIX=session

# --- Пути ---
DATA_DIR=data
EXPORT_DIR=data/exports

# --- Вход в дашборд ---
MAPS_USERNAME=admin
MAPS_PASSWORD=***REMOVED-PASSWORD***

# --- AI-функции (опционально) ---
# Без этого ключа система работает полностью — только AI-объяснение дефицита недоступно.
# Получить ключ: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
