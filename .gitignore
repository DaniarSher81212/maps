# =============================================================================
# .gitignore — файлы и папки, которые НЕ попадают в git
#
# Зачем?
#   В git должен быть только исходный код. Сгенерированные файлы,
#   секреты (.env), кэши и виртуальное окружение не нужны в репозитории.
# =============================================================================

# --- Виртуальное окружение Python ---
# Создаётся командой: python -m venv .venv
# Содержит все установленные библиотеки — их не коммитим,
# у каждого разработчика своё окружение
.venv/
venv/
env/

# --- Секреты и конфигурация окружения ---
# .env содержит пароли, токены — НИКОГДА не коммитим!
# Вместо него коммитим .env.example (без реальных значений)
.env
.env.local
.env.*.local

# --- Файлы Python ---
# Скомпилированные .pyc файлы (кэш интерпретатора)
__pycache__/
*.pyc
*.pyo
*.pyd
# Метаданные установленного пакета (генерируется при pip install -e .)
*.egg-info/
# Собранный дистрибутив
dist/
build/

# --- Логи ---
# Логи генерируются при работе программы — не нужны в git
logs/*.log
logs/*.txt
# Но саму папку logs сохраняем (через .gitkeep)

# --- Данные ---
# Excel-файлы с реальными данными не коммитим (могут содержать конфиденциальное)
data/**/*.xlsx
data/**/*.xls
data/**/*.csv
# Результаты экспорта (генерируются при работе)
data/exports/
# Тестовые Excel-файлы (генерируются скриптом generate_test_scenarios.py)
data/test/

# --- Результаты тестов и покрытие ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- IDE ---
.idea/
.vscode/
*.swp

# --- БД ---
*.db
*.sqlite
*.sqlite3

# --- macOS ---
.DS_Store

# --- Временные файлы ---
*.tmp
*.bak
